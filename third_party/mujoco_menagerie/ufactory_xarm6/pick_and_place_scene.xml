    <body name="cube" pos="0.6 0 0.135">
      <freejoint/>
      <geom name="cube_geom" size="0.04 0.04 0.04" type="box" 
            rgba="1 0 0 1" mass="0.1" friction="1 0.005 0.0001"
            contype="1" conaffinity="1" condim="4"/>
    </body>

    <camera name="top_cam" pos="0.4 0 1.0" mode="fixed" zaxis="0 0 1" fovy="60"/>
  </worldbody>
